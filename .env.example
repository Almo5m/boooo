# توكن البوت من @BotFather
BOT_TOKEN=123456:ABC-YOUR-TOKEN-HERE

# آيديات المالك (مفصولة بفاصلة) - هتلاقي الآيدي بتاعك من @userinfobot
# التحكم الكامل (أوامر الإدارة ولوحة الخاص) مقصور على المالك + المشرفين اللي تضيفهم من الخاص
OWNER_IDS=123456789

# قاعدة البيانات (SQLite افتراضي، ممكن تحطي رابط Postgres لو عندك على Railway)
DATABASE_URL=sqlite:///./edubot.db

# ---- الدردشة الذكية (اختياري بس منصوح بيه) ----
# اختار مزوّد واحد بس وحط مفتاحه، سيب الباقي فاضي:
AI_PROVIDER=groq

# Groq (مجاني تمامًا وسريع) - سجل على https://console.groq.com
GROQ_API_KEY=

# OpenRouter (فيه موديلات مجانية زي llama) - سجل على https://openrouter.ai
OPENROUTER_API_KEY=

# Google Gemini (مجاني بحدود يومية) - سجل على https://aistudio.google.com/apikey
GEMINI_API_KEY=

# لو عايز تحدد موديل معين بدل الافتراضي
AI_MODEL=

# الاسم اللي البوت هيرد بيه على نفسه ولما حد ينادي عليه
BOT_PERSONA_NAME=بو
