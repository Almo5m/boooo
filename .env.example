# توكن البوت من @BotFather
BOT_TOKEN=123456:ABC-YOUR-TOKEN-HERE

# آيديات الأدمنية (مفصولة بفاصلة) - هتلاقي الآيدي بتاعك من @userinfobot
OWNER_IDS=123456789

# آيدي الجروب الرئيسي (اختياري - لو عايز البوت يشتغل جروب واحد بس)
MAIN_GROUP_ID=

# بيانات دخول لوحة التحكم
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me_please

# سيكرت كي للسيشن
SECRET_KEY=change_this_to_a_random_long_string

# قاعدة البيانات (SQLite افتراضي، ممكن تحطي رابط Postgres لو عندك على Railway)
DATABASE_URL=sqlite:///./edubot.db

# البورت اللي Railway هيحطه تلقائي
PORT=8000

# ---- الدردشة الذكية (اختياري بس منصوح بيه) ----
# سجل مجانًا على https://console.groq.com واعمل API Key من تبويب API Keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# الاسم اللي البوت هيرد بيه على نفسه ولما حد ينادي عليه
BOT_PERSONA_NAME=مستر روبوت
